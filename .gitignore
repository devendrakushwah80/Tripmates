# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

*.hprof

# OS / archive noise
Thumbs.db
ehthumbs.db
Desktop.ini
__MACOSX/

# Local environment / secrets
.env
.env.*
!.env.example
tripmates_backend/.env
tripmates_backend/.env.*
!tripmates_backend/.env.example

# PHP backend dependencies and runtime files
tripmates_backend/vendor/
tripmates_backend/logs/*
!tripmates_backend/logs/.gitkeep
tripmates_backend/storage/rate_limits/*
!tripmates_backend/storage/rate_limits/.gitkeep

# Uploaded user files: keep folders, ignore uploaded content
tripmates_backend/uploads/profile/*
tripmates_backend/uploads/selfie/*
tripmates_backend/uploads/dl/*
tripmates_backend/uploads/rc/*
!tripmates_backend/uploads/profile/.gitkeep
!tripmates_backend/uploads/selfie/.gitkeep
!tripmates_backend/uploads/dl/.gitkeep
!tripmates_backend/uploads/rc/.gitkeep

# Android signing / generated local config
android/key.properties
android/app/*.jks
android/app/*.keystore
android/app/google-services.json

# iOS/macOS local dependency outputs
ios/Pods/
macos/Pods/
ios/Flutter/Flutter.podspec

# Local editor/workspace files
.vscode/*
!.vscode/extensions.json
