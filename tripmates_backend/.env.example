APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tripmates
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=replace_with_64_plus_random_characters
