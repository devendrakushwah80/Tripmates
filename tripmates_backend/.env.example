REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=https://your-flutter-web-domain.com
