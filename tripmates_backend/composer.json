{
  "name": "tripmates/backend",
  "description": "Production-oriented Core PHP REST backend for TripMates.",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\Config\\": "config/",
      "App\\Controllers\\": "controllers/",
      "App\\Middleware\\": "middleware/",
      "App\\Models\\": "models/",
      "App\\Services\\": "services/",
      "App\\Helpers\\": "helpers/",
      "App\\Utils\\": "utils/"
    }
  }
}
